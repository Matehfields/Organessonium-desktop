<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Organessonium.NetworkTests</RootNamespace>
    <AssemblyName>Organessonium.NetworkTests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWPF>true</UseWPF>
    <!-- The referenced app assembly already initializes the Windows App SDK. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkCompatibilityInitialize>false</WindowsAppSdkCompatibilityInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WarningsAsErrors>$(WarningsAsErrors);CS0436</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <ProjectReference Include="..\..\Organessonium\Organessonium\Organessonium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\metadata-v1-vector.json" Link="metadata-v1-vector.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\metadata-v1-interop.cjs" Link="metadata-v1-interop.cjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
