<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Organessonium.DesktopEntryPoint</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
	  <WindowsPackageType>None</WindowsPackageType>
	  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	  <EnableMsixTooling>true</EnableMsixTooling>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <SelfContained>true</SelfContained>
	  <PublishSingleFile>true</PublishSingleFile>
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	  <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Organessônium</AssemblyTitle>
    <Product>Organessônium</Product>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="536870912" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Organessonium.NetworkTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.19.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260804001" Condition="'$(WindowsAppSDKSelfContained)' == 'false'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\**\*.*">
      <LogicalName>web/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Resource Include="Assets\app.ico" />
    <!-- Only the explicit archive may enter the single-file publication. -->
    <Content Remove="media\**\*" />
    <None Remove="media\**\*" />
    <EmbeddedResource Include="media\runtime-package.zip" Condition="Exists('media\runtime-package.zip')">
      <LogicalName>media/runtime-package.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="media\source-manifest.json">
      <LogicalName>media/source-manifest.json</LogicalName>
    </EmbeddedResource>
    <Content Include="media\**\*" Exclude="media\sources\**\*;media\build\**\*" Condition="!Exists('media\runtime-package.zip')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="VerifyMediaRuntime" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('media\runtime-package.zip') And !Exists('media\ffmpeg.exe')" Text="FFmpeg ausente. Prepare o pacote de mídia conforme media/NOTICE.md antes de publicar." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\media\Verify-Sources.ps1&quot; -MediaDirectory &quot;$(MSBuildProjectDirectory)\media&quot;" />
  </Target>

  <Target Name="CopyMediaRuntime" AfterTargets="Publish" Condition="!Exists('media\runtime-package.zip')">
    <ItemGroup>
      <_MediaRuntimeFile Include="media\**\*" Exclude="media\sources\**\*;media\build\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_MediaRuntimeFile)"
          DestinationFiles="@(_MediaRuntimeFile->'$(PublishDir)media\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveGeneratedWebFolder" AfterTargets="Build;Publish">
    <RemoveDir Directories="$(OutDir)web" Condition="Exists('$(OutDir)web')" />
    <RemoveDir Directories="$(PublishDir)web" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)web')" />
  </Target>

</Project>
