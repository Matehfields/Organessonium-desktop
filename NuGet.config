<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Mantém a restauração previsível: apenas o feed oficial do NuGet.
    Fontes adicionadas por políticas da máquina não alteram a resolução.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
